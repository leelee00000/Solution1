{
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "baseline": {
      "const": "V80"
    },
    "description": {
      "type": "string"
    },
    "opportunities": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/opportunity"
      }
    }
  },
  "required": [
    "schemaVersion",
    "baseline",
    "description",
    "opportunities"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "opportunity": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "cat": {
          "enum": [
            "竞赛",
            "科研",
            "项目",
            "创业"
          ]
        },
        "direction": {
          "enum": [
            "科技创新",
            "设计创意",
            "创业实践",
            "学术科研",
            "综合创新"
          ]
        },
        "org": {
          "type": "string"
        },
        "aud": {
          "type": "string"
        },
        "field": {
          "type": "string"
        },
        "a": {
          "type": "number",
          "description": "Legacy display angle; ignored by the current renderer. New records may omit it."
        },
        "note": {
          "type": "string"
        },
        "id": {
          "type": "string",
          "pattern": "^fm-(?:[0-9]{3}|[1-9][0-9]{3,8})$",
          "description": "Stable record identity for one edition, track and scope. Never recycle an ID for a different opportunity."
        },
        "dates": {
          "type": "object",
          "properties": {
            "start": {
              "type": [
                "string",
                "null"
              ],
              "format": "date"
            },
            "end": {
              "type": [
                "string",
                "null"
              ],
              "format": "date"
            },
            "award": {
              "type": [
                "string",
                "null"
              ],
              "format": "date"
            },
            "deadlineAt": {
              "type": [
                "string",
                "null"
              ],
              "format": "date-time"
            },
            "timezone": {
              "const": "Asia/Shanghai"
            },
            "published": {
              "type": [
                "string",
                "null"
              ],
              "format": "date"
            }
          },
          "required": [
            "start",
            "end",
            "award",
            "deadlineAt",
            "timezone",
            "published"
          ],
          "additionalProperties": false
        },
        "source": {
          "type": "object",
          "properties": {
            "url": {
              "type": "string",
              "format": "uri",
              "pattern": "^https://"
            },
            "kind": {
              "enum": [
                "official-notice",
                "organizer-site"
              ]
            },
            "verification": {
              "enum": [
                "pending",
                "verified",
                "rejected"
              ]
            },
            "verifiedAt": {
              "type": [
                "string",
                "null"
              ],
              "format": "date"
            },
            "lastAttemptAt": {
              "type": [
                "string",
                "null"
              ],
              "format": "date"
            },
            "lastAttemptResult": {
              "type": "string"
            },
            "importedClaimedCheckedAt": {
              "type": [
                "string",
                "null"
              ],
              "format": "date"
            },
            "importedClaimedStatus": {
              "type": "string"
            },
            "registrationOpenOn": {
              "type": [
                "string",
                "null"
              ],
              "format": "date"
            },
            "evidence": {
              "type": "object",
              "properties": {
                "bodySha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "quotes": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "minItems": 1
                },
                "scope": {
                  "type": "string"
                },
                "documentUrl": {
                  "type": "string",
                  "format": "uri",
                  "pattern": "^https://"
                },
                "monitorHash": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "monitorRegion": {
                  "type": "object",
                  "properties": {
                    "start": {
                      "type": "string",
                      "minLength": 1
                    },
                    "end": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "start",
                    "end"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
                "bodySha256",
                "quotes",
                "scope"
              ],
              "additionalProperties": false
            },
            "importedEnd": {
              "type": [
                "string",
                "null"
              ],
              "format": "date"
            }
          },
          "required": [
            "url",
            "kind",
            "verification",
            "verifiedAt",
            "lastAttemptAt",
            "lastAttemptResult",
            "importedClaimedCheckedAt",
            "importedClaimedStatus"
          ],
          "additionalProperties": false,
          "allOf": [
            {
              "if": {
                "properties": {
                  "verification": {
                    "const": "verified"
                  }
                }
              },
              "then": {
                "properties": {
                  "verifiedAt": {
                    "type": "string",
                    "format": "date"
                  }
                },
                "required": [
                  "evidence"
                ]
              }
            }
          ]
        },
        "eligibility": {
          "type": "object",
          "properties": {
            "schools": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "uniqueItems": true
            },
            "regions": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "uniqueItems": true
            },
            "degrees": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "uniqueItems": true
            },
            "enrollmentYears": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 1980,
                "maximum": 2100
              },
              "uniqueItems": true
            },
            "studyYears": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 1,
                "maximum": 6
              },
              "uniqueItems": true
            },
            "majorGroups": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "uniqueItems": true
            },
            "enrolled": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "rulesComplete": {
              "type": "boolean"
            },
            "basis": {
              "type": "string"
            },
            "studyModes": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "uniqueItems": true
            },
            "leaderStudyYears": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 1,
                "maximum": 6
              },
              "uniqueItems": true
            },
            "teamSize": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "type": "object",
                  "properties": {
                    "min": {
                      "type": [
                        "integer",
                        "null"
                      ],
                      "minimum": 1
                    },
                    "max": {
                      "type": "integer",
                      "minimum": 1
                    }
                  },
                  "required": [
                    "min",
                    "max"
                  ],
                  "additionalProperties": false
                }
              ]
            },
            "requirements": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[a-z][a-z-]*$"
                  },
                  "label": {
                    "type": "string",
                    "minLength": 1
                  },
                  "quote": {
                    "type": "string",
                    "minLength": 1
                  },
                  "whenRole": {
                    "enum": [
                      "负责人",
                      "成员"
                    ]
                  }
                },
                "required": [
                  "id",
                  "label",
                  "quote"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "schools",
            "regions",
            "degrees",
            "enrollmentYears",
            "studyYears",
            "majorGroups",
            "enrolled",
            "rulesComplete",
            "basis",
            "studyModes",
            "leaderStudyYears",
            "teamSize",
            "requirements"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "name",
        "cat",
        "direction",
        "org",
        "aud",
        "field",
        "note",
        "id",
        "dates",
        "source",
        "eligibility"
      ],
      "additionalProperties": false
    }
  }
}
